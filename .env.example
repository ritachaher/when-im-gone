# Copy to .env.local and fill in from Firebase console -> Project settings -> General
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
# Optional: Firebase App Check (reCAPTCHA Enterprise site key). When set, all
# Firestore calls carry an app attestation. After enabling in the Firebase
# console, flip appCheck() in firestore.rules to `request.app != null`.
VITE_APPCHECK_SITE_KEY=
